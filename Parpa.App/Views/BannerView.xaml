<UserControl
    x:Class="Parpa.Views.BannerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="300"
    Height="34">

    <!-- Error breve compacto (Icono y Estados #11f): punto rojo + etiqueta + enlace. Padding 0 14 2, gap 10. -->
    <Grid Padding="14,0,14,2" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="Dot" Width="6" Height="6" VerticalAlignment="Center" />
        <TextBlock
            x:Name="Label"
            Grid.Column="1"
            VerticalAlignment="Center"
            FontFamily="{StaticResource FontUi}"
            FontSize="13"
            FontWeight="SemiBold"
            Foreground="{StaticResource PrimaryBrush}"
            TextTrimming="CharacterEllipsis" />
        <TextBlock
            x:Name="Link"
            Grid.Column="2"
            VerticalAlignment="Center"
            FontFamily="{StaticResource FontUi}"
            FontSize="12"
            Foreground="{StaticResource SecondaryBrush}" />
    </Grid>
</UserControl>
