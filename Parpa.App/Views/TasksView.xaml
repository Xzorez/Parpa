<UserControl
    x:Class="Parpa.Views.TasksView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Parpa.Controls">

    <Grid>
        <Grid x:Name="ListPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- "HOY" + contador Doto 700 16. -->
            <Grid Padding="4,0,4,6">
                <TextBlock x:Name="TodayLabel" VerticalAlignment="Bottom" Style="{StaticResource CardLabel}" />
                <TextBlock
                    x:Name="Count"
                    HorizontalAlignment="Right"
                    FontFamily="{StaticResource FontDisplay}"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{StaticResource PrimaryBrush}" />
            </Grid>

            <!-- Filas: padding 7 4, borde superior #1e1e21; círculo 10 px; clic alterna hecha. -->
            <ScrollViewer
                x:Name="ListScroll"
                Grid.Row="1"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="Rows" />
            </ScrollViewer>

            <!-- "+ NUEVA TAREA" → campo de texto (Enter añade, Esc cancela). -->
            <Grid
                Grid.Row="2"
                Padding="4,8,4,0"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0">
                <TextBlock
                    x:Name="NewLabel"
                    CharacterSpacing="80"
                    FontFamily="{StaticResource FontMono}"
                    FontSize="10"
                    FontWeight="Medium"
                    Foreground="{StaticResource SecondaryBrush}"
                    Tapped="NewLabel_Tapped" />
                <TextBox
                    x:Name="NewBox"
                    FontSize="12"
                    KeyDown="NewBox_KeyDown"
                    LostFocus="NewBox_LostFocus"
                    Style="{StaticResource BareTextBox}"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- Todo hecho: mascota contenta + "TODO HECHO" (Doto 900 22) + botón. -->
        <StackPanel
            x:Name="DonePanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="14"
            Visibility="Collapsed">
            <c:DotMatrix
                x:Name="DoneMascot"
                HorizontalAlignment="Center"
                Columns="13"
                Rows="5"
                DotSize="4"
                Gap="2"
                OnBrush="{StaticResource PrimaryBrush}"
                OffBrush="{StaticResource MatrixOffBrush}" />
            <StackPanel HorizontalAlignment="Center" Spacing="4">
                <TextBlock
                    x:Name="DoneTitle"
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource FontDisplay}"
                    FontSize="22"
                    FontWeight="Black"
                    Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock
                    x:Name="DoneText"
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource FontUi}"
                    FontSize="12"
                    Foreground="{StaticResource SecondaryBrush}" />
            </StackPanel>
            <c:PillButton
                x:Name="DoneNew"
                HorizontalAlignment="Center"
                Foreground="{StaticResource SoftBrush}"
                Click="DoneNew_Click" />
        </StackPanel>
    </Grid>
</UserControl>
