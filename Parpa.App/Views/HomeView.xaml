<UserControl
    x:Class="Parpa.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Parpa.Controls">

    <Grid>
        <!-- Estilo Akira: carátula en duotono a la izquierda, título ancho y una píldora con progreso y controles;
             debajo, píldoras con borde: CPU, GPU, RAM (la más alta, rellena), volumen y próxima tarea. -->
        <Grid x:Name="Cards" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- MÚSICA -->
            <Grid x:Name="MusicCard" Height="100">
                <Grid x:Name="MusicFilled" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Carátula a dos tintas (negro y rosa), con grano; nota si la app no la da. -->
                    <Border
                        x:Name="ArtTile"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1.5"
                        CornerRadius="10">
                        <Grid>
                            <TextBlock
                                x:Name="ArtIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="26"
                                Foreground="{StaticResource PrimaryBrush}"
                                Text="&#xE8D6;" />
                            <Image x:Name="Artwork" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="24" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="MusicTitle" FontSize="21" LineHeight="25" Style="{StaticResource Wide}" />
                        <!-- Adornos de cartel: píldora, onda y estrella. -->
                        <StackPanel
                            Grid.Row="1"
                            Margin="0,4,0,0"
                            Orientation="Horizontal"
                            Spacing="10">
                            <Border
                                Width="40"
                                Height="14"
                                VerticalAlignment="Center"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                BorderThickness="1.4"
                                CornerRadius="7">
                                <Border
                                    Height="1.4"
                                    Margin="6,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource PrimaryBrush}" />
                            </Border>
                            <Path
                                Width="48"
                                Height="14"
                                VerticalAlignment="Center"
                                Data="M1,7 C4,-1 7,15 10,7 S16,-1 19,7 S25,15 28,7 S34,-1 37,7 S43,15 46,7"
                                Stroke="{StaticResource PrimaryBrush}"
                                StrokeThickness="1.4" />
                            <Grid Width="14" Height="14" VerticalAlignment="Center">
                                <Ellipse Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.3" />
                                <Path
                                    Data="M7,1 V13 M1,7 H13 M2.8,2.8 L11.2,11.2 M11.2,2.8 L2.8,11.2"
                                    Stroke="{StaticResource PrimaryBrush}"
                                    StrokeThickness="1.1" />
                            </Grid>
                        </StackPanel>
                        <TextBlock x:Name="MusicApp" Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource Tiny}" />

                        <!-- Píldora: tiempo · línea con bolita · lo que falta · anterior, play/pausa, siguiente. -->
                        <Border
                            Grid.Row="4"
                            Padding="10,0,3,0"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="1.5"
                            CornerRadius="12">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="MusicPosition" Style="{StaticResource Tiny}" CharacterSpacing="60" />
                                <Grid
                                    x:Name="MusicProgress"
                                    Grid.Column="1"
                                    Height="9"
                                    VerticalAlignment="Center">
                                    <Border
                                        x:Name="MusicTrack"
                                        Height="1.5"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource PrimaryBrush}" />
                                    <Ellipse
                                        x:Name="MusicKnob"
                                        Width="9"
                                        Height="9"
                                        HorizontalAlignment="Left"
                                        Fill="{StaticResource PrimaryBrush}" />
                                </Grid>
                                <TextBlock x:Name="MusicDuration" Grid.Column="2" Style="{StaticResource Tiny}" CharacterSpacing="60" />
                                <StackPanel
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="1">
                                    <Border
                                        x:Name="PreviousButton"
                                        Width="20"
                                        Height="18"
                                        Background="Transparent"
                                        Tapped="PreviousButton_Tapped">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="9"
                                            Style="{StaticResource MediaControl}"
                                            Text="&#xE892;" />
                                    </Border>
                                    <Border
                                        x:Name="PlayPauseButton"
                                        Width="18"
                                        Height="18"
                                        Background="{StaticResource PrimaryBrush}"
                                        CornerRadius="9"
                                        Tapped="PlayPauseButton_Tapped">
                                        <TextBlock
                                            x:Name="PlayPauseIcon"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="8"
                                            Foreground="{StaticResource BgBrush}"
                                            Style="{StaticResource MediaControl}"
                                            Text="&#xE769;" />
                                    </Border>
                                    <Border
                                        x:Name="NextButton"
                                        Width="20"
                                        Height="18"
                                        Background="Transparent"
                                        Tapped="NextButton_Tapped">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="9"
                                            Style="{StaticResource MediaControl}"
                                            Text="&#xE893;" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Sin música: marco con la nota y el aviso. -->
                <Grid x:Name="MusicEmpty" ColumnSpacing="12" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1.5"
                        CornerRadius="10">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="26"
                            Foreground="{StaticResource PrimaryBrush}"
                            Text="&#xE8D6;" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <TextBlock x:Name="MusicEmptyLabel" Style="{StaticResource Tiny}" />
                        <TextBlock x:Name="NoMusicTitle" FontSize="18" Style="{StaticResource Wide}" />
                        <TextBlock
                            x:Name="NoMusicText"
                            MaxLines="2"
                            LineHeight="14"
                            Style="{StaticResource Tiny}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Píldoras: CPU, GPU, RAM (código), volumen de la app que suena y próxima tarea. -->
            <Grid x:Name="Chips" Grid.Row="1" Height="34" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CpuColumn" Width="*" />
                    <ColumnDefinition x:Name="GpuColumn" Width="*" />
                    <ColumnDefinition x:Name="RamColumn" Width="*" />
                    <ColumnDefinition x:Name="VolumeColumn" Width="0" />
                    <ColumnDefinition x:Name="TaskColumn" Width="2.2*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="MusicVolume"
                    Grid.Column="3"
                    Padding="10,0"
                    Background="Transparent"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    PointerWheelChanged="MusicVolume_PointerWheelChanged"
                    Visibility="Collapsed">
                    <Grid x:Name="MusicVolumeRow" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MusicVolumeLabel" Style="{StaticResource Tiny}" Text="VOL" />
                        <TextBlock
                            x:Name="MusicVolumeValue"
                            Grid.Column="2"
                            MinWidth="30"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Style="{StaticResource Wide}"
                            TextAlignment="Right" />
                    </Grid>
                </Border>

                <!-- PRÓXIMA TAREA: círculo para marcarla hecha, texto y hora. -->
                <Border
                    x:Name="TaskCard"
                    Grid.Column="4"
                    Padding="10,0"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="1.5"
                    CornerRadius="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="TaskDone"
                            Width="14"
                            Height="14"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="1.5"
                            CornerRadius="7"
                            Tapped="TaskDone_Tapped" />
                        <TextBlock x:Name="TaskText" Grid.Column="1" Style="{StaticResource Tiny}" />
                        <TextBlock
                            x:Name="TaskTime"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Style="{StaticResource Wide}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Permiso de avisos denegado: tarjeta arriba con la mascota apagada y ACTIVAR; se puede ocultar. -->
        <StackPanel x:Name="DeniedPanel" Spacing="12" Visibility="Collapsed">
            <Grid
                Padding="14,12"
                Background="{StaticResource CardBrush}"
                ColumnSpacing="14"
                CornerRadius="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:DotMatrix
                    x:Name="DeniedMascot"
            Merge="Blobs"
                    VerticalAlignment="Center"
                    Columns="13"
                    Rows="5"
                    DotSize="3"
                    Gap="1.5"
                    OnBrush="{StaticResource MutedBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        x:Name="DeniedTitle"
                        FontFamily="{StaticResource FontUi}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock
                        x:Name="DeniedText"
                        FontFamily="{StaticResource FontUi}"
                        FontSize="12"
                        Foreground="{StaticResource SecondaryBrush}"
                        LineHeight="16.2"
                        TextWrapping="Wrap" />
                </StackPanel>
                <c:PillButton
                    x:Name="DeniedEnable"
                    Grid.Column="2"
                    Padding="11,7"
                    Primary="True"
                    Click="DeniedEnable_Click" />
            </Grid>
            <TextBlock
                x:Name="DeniedHint"
                FontFamily="{StaticResource FontUi}"
                FontSize="11"
                Foreground="{StaticResource TertiaryBrush}"
                Tapped="DeniedHint_Tapped" />
        </StackPanel>
    </Grid>
</UserControl>
