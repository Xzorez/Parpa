<UserControl
    x:Class="Parpa.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Parpa.Controls">

    <Grid>
        <!-- Tarjetas: Música 1.5fr | Sistema 1fr | Próxima tarea 1fr, gap 10. -->
        <Grid x:Name="Cards" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MusicColumn" Width="1.5*" />
                <ColumnDefinition x:Name="SystemColumn" Width="*" />
                <ColumnDefinition x:Name="TaskColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- MÚSICA -->
            <Grid x:Name="MusicCard" Grid.Column="0">
                <Border
                    x:Name="MusicFilled"
                    Padding="14,12"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="20">
                    <Grid RowSpacing="9">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Resplandor del color de la carátula, detrás de todo (fuera del hueco de 48 px para que no se recorte). -->
                        <Border
                            x:Name="ArtworkGlow"
                            Grid.RowSpan="4"
                            Width="150"
                            Height="120"
                            Margin="-50,-44,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Carátula 48 px, radio 12, con un resplandor de su color detrás (nota si la app no la da). -->
                            <Grid Width="48" Height="48">
                                <Grid Background="{StaticResource BorderBrush}" CornerRadius="12">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        FontSize="20"
                                        Foreground="{StaticResource MutedBrush}"
                                        Text="&#xE8D6;" />
                                    <Image x:Name="Artwork" Stretch="UniformToFill" />
                                </Grid>
                            </Grid>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="3">
                                <TextBlock
                                    x:Name="MusicTitle"
                                    FontFamily="{StaticResource FontUi}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="MusicApp"
                                    FontFamily="{StaticResource FontUi}"
                                    FontSize="12"
                                    Foreground="{StaticResource SecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <!-- Progreso: línea continua de 4 px. -->
                        <Grid x:Name="MusicProgress" Grid.Row="1" Height="4" Margin="0,3,0,0">
                            <Border Background="{StaticResource BorderBrush}" CornerRadius="2" />
                            <Border
                                x:Name="MusicProgressFill"
                                Width="0"
                                HorizontalAlignment="Left"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="2" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <TextBlock
                                x:Name="MusicPosition"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource FontUi}"
                                FontSize="11"
                                Foreground="{StaticResource MutedBrush}" />
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="22">
                                <TextBlock x:Name="PreviousButton" VerticalAlignment="Center" Text="&#xE892;" Style="{StaticResource MediaControl}" Tapped="PreviousButton_Tapped" />
                                <TextBlock x:Name="PlayPauseButton" VerticalAlignment="Center" FontSize="20" Text="&#xE769;" Style="{StaticResource MediaControl}" Tapped="PlayPauseButton_Tapped" />
                                <TextBlock x:Name="NextButton" VerticalAlignment="Center" Text="&#xE893;" Style="{StaticResource MediaControl}" Tapped="NextButton_Tapped" />
                            </StackPanel>
                            <TextBlock
                                x:Name="MusicDuration"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource FontUi}"
                                FontSize="11"
                                Foreground="{StaticResource MutedBrush}" />
                        </Grid>
                        <!-- Volumen de la app que suena (Spotify, el navegador…): VOL + barras + valor. -->
                        <Grid
                            x:Name="MusicVolume"
                            Grid.Row="3"
                            Background="Transparent"
                            ColumnSpacing="6"
                            PointerWheelChanged="MusicVolume_PointerWheelChanged"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="MusicVolumeLabel"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="12"
                                Foreground="{StaticResource MutedBrush}"
                                Text="&#xE993;" />
                            <TextBlock
                                x:Name="MusicVolumeValue"
                                Grid.Column="2"
                                MinWidth="30"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource FontUi}"
                                FontSize="11"
                                Foreground="{StaticResource MutedBrush}"
                                TextAlignment="Right" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Sin música: la tarjeta se queda, vacía. -->
                <Grid x:Name="MusicEmpty" Background="{StaticResource CardBrush}" CornerRadius="20" Visibility="Collapsed">
                    <Grid Padding="14,12">
                        <TextBlock x:Name="MusicEmptyLabel" Style="{StaticResource CardLabel}" VerticalAlignment="Top" />
                        <StackPanel VerticalAlignment="Bottom" Spacing="4">
                            <TextBlock
                                x:Name="NoMusicTitle"
                                FontFamily="{StaticResource FontUi}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock
                                x:Name="NoMusicText"
                                FontFamily="{StaticResource FontUi}"
                                FontSize="12"
                                Foreground="{StaticResource SecondaryBrush}"
                                LineHeight="16.2"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- SISTEMA -->
            <Border
                x:Name="SystemCard"
                Grid.Column="1"
                Padding="14,12"
                Background="{StaticResource CardBrush}"
                CornerRadius="20">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SystemLabel" Style="{StaticResource CardLabel}" />
                    <!-- CPU, GPU y RAM en anillos de color. -->
                    <Grid x:Name="SystemRows" Grid.Row="1" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- PRÓXIMA TAREA -->
            <Border
                x:Name="TaskCard"
                Grid.Column="2"
                Padding="14,12"
                Background="{StaticResource CardBrush}"
                CornerRadius="20">
                <Grid>
                    <Grid VerticalAlignment="Top">
                        <TextBlock x:Name="TaskLabel" Style="{StaticResource CardLabel}" />
                        <TextBlock
                            x:Name="TaskTime"
                            HorizontalAlignment="Right"
                            FontFamily="{StaticResource FontUi}"
                            FontSize="12"
                            FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock
                        x:Name="TaskText"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontUi}"
                        FontSize="13"
                        Foreground="{StaticResource PrimaryBrush}"
                        LineHeight="17.55"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <c:PillButton x:Name="TaskDone" VerticalAlignment="Bottom" Click="TaskDone_Click" />
                </Grid>
            </Border>
        </Grid>

        <!-- Permiso de avisos denegado: tarjeta arriba con la mascota apagada y ACTIVAR; se puede ocultar. -->
        <StackPanel x:Name="DeniedPanel" Spacing="12" Visibility="Collapsed">
            <Grid
                Padding="14,12"
                Background="{StaticResource CardBrush}"
                ColumnSpacing="14"
                CornerRadius="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:DotMatrix
                    x:Name="DeniedMascot"
            Merge="Blobs"
                    VerticalAlignment="Center"
                    Columns="13"
                    Rows="5"
                    DotSize="3"
                    Gap="1.5"
                    OnBrush="{StaticResource MutedBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        x:Name="DeniedTitle"
                        FontFamily="{StaticResource FontUi}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock
                        x:Name="DeniedText"
                        FontFamily="{StaticResource FontUi}"
                        FontSize="12"
                        Foreground="{StaticResource SecondaryBrush}"
                        LineHeight="16.2"
                        TextWrapping="Wrap" />
                </StackPanel>
                <c:PillButton
                    x:Name="DeniedEnable"
                    Grid.Column="2"
                    Padding="11,7"
                    Primary="True"
                    Click="DeniedEnable_Click" />
            </Grid>
            <TextBlock
                x:Name="DeniedHint"
                FontFamily="{StaticResource FontUi}"
                FontSize="11"
                Foreground="{StaticResource TertiaryBrush}"
                Tapped="DeniedHint_Tapped" />
        </StackPanel>
    </Grid>
</UserControl>
