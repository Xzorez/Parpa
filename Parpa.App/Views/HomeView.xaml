<UserControl
    x:Class="Parpa.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Parpa.Controls">

    <Grid>
        <!-- Música arriba (carátula de fondo) y una fila de píldoras debajo: CPU, GPU, RAM, volumen y próxima tarea. -->
        <Grid x:Name="Cards" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- MÚSICA -->
            <Grid x:Name="MusicCard" Height="100">
                <Grid x:Name="MusicFilled" Background="{StaticResource CardBrush}" CornerRadius="20">
                    <!-- Fondo: la carátula decodificada a 12 px y estirada se ve difuminada; encima, un velo oscuro. -->
                    <Image
                        x:Name="ArtBackdrop"
                        Margin="-30"
                        IsHitTestVisible="False"
                        Opacity="0"
                        Stretch="UniformToFill" />
                    <Border x:Name="ArtShade" IsHitTestVisible="False" Opacity="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#14000000" />
                                <GradientStop Offset="1" Color="#73000000" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid Padding="12" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Carátula 76 px, radio 14 (nota si la app no la da). -->
                        <Grid
                            x:Name="ArtTile"
                            Width="76"
                            Height="76"
                            Background="#33FFFFFF"
                            CornerRadius="14">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                x:Name="ArtIcon"
                                FontSize="26"
                                Foreground="#B3FFFFFF"
                                Text="&#xE8D6;" />
                            <Image x:Name="Artwork" Stretch="UniformToFill" />
                        </Grid>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,2,12,0" Spacing="2">
                                <TextBlock
                                    x:Name="MusicTitle"
                                    FontFamily="{StaticResource FontUi}"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="MusicApp"
                                    FontFamily="{StaticResource FontUi}"
                                    FontSize="12"
                                    Foreground="#B3FFFFFF"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Margin="0,2,2,0"
                                VerticalAlignment="Top"
                                Orientation="Horizontal"
                                Spacing="18">
                                <TextBlock x:Name="PreviousButton" VerticalAlignment="Center" Foreground="White" Text="&#xE892;" Style="{StaticResource MediaControl}" Tapped="PreviousButton_Tapped" />
                                <TextBlock x:Name="PlayPauseButton" VerticalAlignment="Center" FontSize="22" Foreground="White" Text="&#xE769;" Style="{StaticResource MediaControl}" Tapped="PlayPauseButton_Tapped" />
                                <TextBlock x:Name="NextButton" VerticalAlignment="Center" Foreground="White" Text="&#xE893;" Style="{StaticResource MediaControl}" Tapped="NextButton_Tapped" />
                            </StackPanel>
                            <!-- Progreso: tiempo · línea de 4 px · lo que falta. -->
                            <Grid
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Margin="0,0,2,2"
                                ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="MusicPosition"
                                    MinWidth="30"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource FontUi}"
                                    FontSize="11"
                                    Foreground="#B3FFFFFF" />
                                <Grid
                                    x:Name="MusicProgress"
                                    Grid.Column="1"
                                    Height="4"
                                    VerticalAlignment="Center">
                                    <Border x:Name="MusicTrack" Background="#40FFFFFF" CornerRadius="2" />
                                    <Border
                                        x:Name="MusicProgressFill"
                                        Width="0"
                                        HorizontalAlignment="Left"
                                        Background="White"
                                        CornerRadius="2" />
                                </Grid>
                                <TextBlock
                                    x:Name="MusicDuration"
                                    Grid.Column="2"
                                    MinWidth="34"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource FontUi}"
                                    FontSize="11"
                                    Foreground="#B3FFFFFF"
                                    TextAlignment="Right" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Sin música: la tarjeta se queda, con el icono de nota y el aviso. -->
                <Grid
                    x:Name="MusicEmpty"
                    Padding="12"
                    Background="{StaticResource CardBrush}"
                    ColumnSpacing="14"
                    CornerRadius="20"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Background="{StaticResource BorderBrush}" CornerRadius="14">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="26"
                            Foreground="{StaticResource MutedBrush}"
                            Text="&#xE8D6;" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="MusicEmptyLabel" Style="{StaticResource CardLabel}" />
                        <TextBlock
                            x:Name="NoMusicTitle"
                            FontFamily="{StaticResource FontUi}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock
                            x:Name="NoMusicText"
                            FontFamily="{StaticResource FontUi}"
                            FontSize="12"
                            Foreground="{StaticResource SecondaryBrush}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Píldoras: CPU, GPU, RAM (código), volumen de la app que suena y próxima tarea. -->
            <Grid x:Name="Chips" Grid.Row="1" Height="34" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CpuColumn" Width="*" />
                    <ColumnDefinition x:Name="GpuColumn" Width="*" />
                    <ColumnDefinition x:Name="RamColumn" Width="*" />
                    <ColumnDefinition x:Name="VolumeColumn" Width="0" />
                    <ColumnDefinition x:Name="TaskColumn" Width="2.2*" />
                </Grid.ColumnDefinitions>

                <Grid
                    x:Name="MusicVolume"
                    Grid.Column="3"
                    Padding="12,0"
                    Background="{StaticResource CardBrush}"
                    ColumnSpacing="8"
                    CornerRadius="14"
                    PointerWheelChanged="MusicVolume_PointerWheelChanged"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="MusicVolumeLabel"
                        VerticalAlignment="Center"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="14"
                        Foreground="{StaticResource SecondaryBrush}"
                        Text="&#xE767;" />
                    <TextBlock
                        x:Name="MusicVolumeValue"
                        Grid.Column="2"
                        MinWidth="28"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontUi}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryBrush}"
                        TextAlignment="Right" />
                </Grid>

                <!-- PRÓXIMA TAREA: círculo para marcarla hecha, texto y hora. -->
                <Grid
                    x:Name="TaskCard"
                    Grid.Column="4"
                    Padding="10,0,12,0"
                    Background="{StaticResource CardBrush}"
                    ColumnSpacing="8"
                    CornerRadius="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="TaskDone"
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="{StaticResource MutedBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Tapped="TaskDone_Tapped" />
                    <TextBlock
                        x:Name="TaskText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontUi}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="TaskTime"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontUi}"
                        FontSize="12"
                        FontWeight="SemiBold" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Permiso de avisos denegado: tarjeta arriba con la mascota apagada y ACTIVAR; se puede ocultar. -->
        <StackPanel x:Name="DeniedPanel" Spacing="12" Visibility="Collapsed">
            <Grid
                Padding="14,12"
                Background="{StaticResource CardBrush}"
                ColumnSpacing="14"
                CornerRadius="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:DotMatrix
                    x:Name="DeniedMascot"
            Merge="Blobs"
                    VerticalAlignment="Center"
                    Columns="13"
                    Rows="5"
                    DotSize="3"
                    Gap="1.5"
                    OnBrush="{StaticResource MutedBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        x:Name="DeniedTitle"
                        FontFamily="{StaticResource FontUi}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock
                        x:Name="DeniedText"
                        FontFamily="{StaticResource FontUi}"
                        FontSize="12"
                        Foreground="{StaticResource SecondaryBrush}"
                        LineHeight="16.2"
                        TextWrapping="Wrap" />
                </StackPanel>
                <c:PillButton
                    x:Name="DeniedEnable"
                    Grid.Column="2"
                    Padding="11,7"
                    Primary="True"
                    Click="DeniedEnable_Click" />
            </Grid>
            <TextBlock
                x:Name="DeniedHint"
                FontFamily="{StaticResource FontUi}"
                FontSize="11"
                Foreground="{StaticResource TertiaryBrush}"
                Tapped="DeniedHint_Tapped" />
        </StackPanel>
    </Grid>
</UserControl>
