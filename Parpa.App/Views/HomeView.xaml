<UserControl
    x:Class="Parpa.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Parpa.Controls">

    <Grid>
        <!-- Tarjetas: MÚSICA 1.5fr | SISTEMA 1fr | PRÓXIMA TAREA 1fr, gap 8. -->
        <Grid x:Name="Cards" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MusicColumn" Width="1.5*" />
                <ColumnDefinition x:Name="SystemColumn" Width="*" />
                <ColumnDefinition x:Name="TaskColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- MÚSICA -->
            <Grid x:Name="MusicCard" Grid.Column="0">
                <Border
                    x:Name="MusicFilled"
                    Padding="12"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Carátula 48 px, radio 8 (fondo de puntos si la app no la da). -->
                            <Grid
                                Width="48"
                                Height="48"
                                Background="{StaticResource DividerBrush}"
                                CornerRadius="8">
                                <c:DotPattern DotBrush="{StaticResource DotPatternBrush}" Spacing="5" CornerRadius="8" />
                                <Image x:Name="Artwork" Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="3">
                                <TextBlock
                                    x:Name="MusicTitle"
                                    FontFamily="{StaticResource FontUi}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="MusicApp"
                                    CharacterSpacing="60"
                                    FontFamily="{StaticResource FontMono}"
                                    FontSize="10"
                                    Foreground="{StaticResource SecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <!-- Progreso: puntos de 4 px, gap 3 (tantos como quepan). -->
                        <c:DotMatrix
                            x:Name="MusicProgress"
                            Grid.Row="1"
                            Rows="1"
                            DotSize="4"
                            Gap="3"
                            OnBrush="{StaticResource PrimaryBrush}"
                            OffBrush="{StaticResource BorderBrush}" />
                        <Grid Grid.Row="2">
                            <TextBlock
                                x:Name="MusicPosition"
                                HorizontalAlignment="Left"
                                FontFamily="{StaticResource FontMono}"
                                FontSize="10"
                                Foreground="{StaticResource SecondaryBrush}" />
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                <TextBlock x:Name="PreviousButton" Text="◀◀" Style="{StaticResource MediaControl}" Tapped="PreviousButton_Tapped" />
                                <TextBlock x:Name="PlayPauseButton" Text="▮▮" Style="{StaticResource MediaControl}" Tapped="PlayPauseButton_Tapped" />
                                <TextBlock x:Name="NextButton" Text="▶▶" Style="{StaticResource MediaControl}" Tapped="NextButton_Tapped" />
                            </StackPanel>
                            <TextBlock
                                x:Name="MusicDuration"
                                HorizontalAlignment="Right"
                                FontFamily="{StaticResource FontMono}"
                                FontSize="10"
                                Foreground="{StaticResource SecondaryBrush}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Sin música: la tarjeta se queda (puntos #2c2c31 de 7 px, borde interior #1e1e21). -->
                <Grid x:Name="MusicEmpty" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="14" Visibility="Collapsed">
                    <c:DotPattern DotColor="#2c2c31" Spacing="7" CornerRadius="14" />
                    <Grid Padding="12">
                        <TextBlock x:Name="MusicEmptyLabel" Style="{StaticResource CardLabel}" VerticalAlignment="Top" />
                        <StackPanel VerticalAlignment="Bottom" Spacing="4">
                            <TextBlock
                                x:Name="NoMusicTitle"
                                FontFamily="{StaticResource FontUi}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock
                                x:Name="NoMusicText"
                                FontFamily="{StaticResource FontUi}"
                                FontSize="12"
                                Foreground="{StaticResource SecondaryBrush}"
                                LineHeight="16.2"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- SISTEMA -->
            <Border
                x:Name="SystemCard"
                Grid.Column="1"
                Padding="12"
                Background="{StaticResource CardBrush}"
                CornerRadius="14">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="SystemLabel" Style="{StaticResource CardLabel}" />
                    <StackPanel x:Name="SystemRows" Spacing="6" />
                </StackPanel>
            </Border>

            <!-- PRÓXIMA TAREA -->
            <Border
                x:Name="TaskCard"
                Grid.Column="2"
                Padding="12"
                Background="{StaticResource CardBrush}"
                CornerRadius="14">
                <Grid>
                    <Grid VerticalAlignment="Top">
                        <TextBlock x:Name="TaskLabel" Style="{StaticResource CardLabel}" />
                        <TextBlock
                            x:Name="TaskTime"
                            HorizontalAlignment="Right"
                            FontFamily="{StaticResource FontMono}"
                            FontSize="10" />
                    </Grid>
                    <TextBlock
                        x:Name="TaskText"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontUi}"
                        FontSize="13"
                        Foreground="{StaticResource PrimaryBrush}"
                        LineHeight="17.55"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <c:PillButton x:Name="TaskDone" VerticalAlignment="Bottom" Click="TaskDone_Click" />
                </Grid>
            </Border>
        </Grid>

        <!-- Permiso de avisos denegado: tarjeta arriba con la mascota apagada y ACTIVAR; se puede ocultar. -->
        <StackPanel x:Name="DeniedPanel" Spacing="12" Visibility="Collapsed">
            <Grid
                Padding="14,12"
                Background="{StaticResource CardBrush}"
                ColumnSpacing="14"
                CornerRadius="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:DotMatrix
                    x:Name="DeniedMascot"
                    VerticalAlignment="Center"
                    Columns="13"
                    Rows="5"
                    DotSize="3"
                    Gap="1.5"
                    OnBrush="{StaticResource MutedBrush}"
                    OffBrush="{StaticResource MatrixOffBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        x:Name="DeniedTitle"
                        FontFamily="{StaticResource FontUi}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock
                        x:Name="DeniedText"
                        FontFamily="{StaticResource FontUi}"
                        FontSize="12"
                        Foreground="{StaticResource SecondaryBrush}"
                        LineHeight="16.2"
                        TextWrapping="Wrap" />
                </StackPanel>
                <c:PillButton
                    x:Name="DeniedEnable"
                    Grid.Column="2"
                    Padding="11,7"
                    Primary="True"
                    Click="DeniedEnable_Click" />
            </Grid>
            <TextBlock
                x:Name="DeniedHint"
                CharacterSpacing="60"
                FontFamily="{StaticResource FontMono}"
                FontSize="9"
                Foreground="{StaticResource TertiaryBrush}"
                Tapped="DeniedHint_Tapped" />
        </StackPanel>
    </Grid>
</UserControl>
