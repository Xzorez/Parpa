<UserControl
    x:Class="Parpa.Views.PeekView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Parpa.Controls"
    Width="420"
    Height="112">

    <!-- Aviso: padding 10 16 12, gap 8. Cabecera + cuerpo con dos botones + barra de tiempo restante. -->
    <StackPanel Padding="16,10,16,12" Spacing="8">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <c:DotMatrix
                x:Name="PeekGlyph"
                VerticalAlignment="Center"
                OffColor="{StaticResource GlyphOffColor}" />
            <TextBlock
                x:Name="Head"
                Grid.Column="1"
                VerticalAlignment="Center"
                CharacterSpacing="100"
                FontFamily="{StaticResource FontMono}"
                FontSize="10"
                FontWeight="Medium"
                Foreground="{StaticResource SecondaryBrush}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="When"
                Grid.Column="2"
                VerticalAlignment="Center"
                FontFamily="{StaticResource FontMono}"
                FontSize="10"
                Foreground="{StaticResource QuaternaryBrush}" />
        </Grid>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Cuerpo Geist 13 px / 1,35, máx. 2 líneas. -->
            <TextBlock
                x:Name="Body"
                VerticalAlignment="Center"
                FontFamily="{StaticResource FontUi}"
                FontSize="13"
                Foreground="{StaticResource PrimaryBrush}"
                LineHeight="17.55"
                LineStackingStrategy="BlockLineHeight"
                MaxLines="2"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <!-- Secundario: borde #2a2a2e. Principal: fondo claro. Píldoras mono 500 10 px, padding 6×10. -->
                <Border
                    x:Name="SecondaryButton"
                    Padding="10,6"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    c:Pill.IsPill="True"
                    PointerEntered="SecondaryButton_PointerEntered"
                    PointerExited="SecondaryButton_PointerExited"
                    Tapped="SecondaryButton_Tapped">
                    <TextBlock
                        x:Name="SecondaryLabel"
                        CharacterSpacing="60"
                        FontFamily="{StaticResource FontMono}"
                        FontSize="10"
                        FontWeight="Medium" />
                </Border>
                <Border
                    x:Name="PrimaryButton"
                    Padding="10,6"
                    c:Pill.IsPill="True"
                    PointerEntered="PrimaryButton_PointerEntered"
                    PointerExited="PrimaryButton_PointerExited"
                    Tapped="PrimaryButton_Tapped">
                    <TextBlock
                        x:Name="PrimaryLabel"
                        CharacterSpacing="60"
                        FontFamily="{StaticResource FontMono}"
                        FontSize="10"
                        FontWeight="Medium"
                        Foreground="{StaticResource BgBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- 30 puntos de 2 px: tiempo restante del aviso. -->
        <c:DotMatrix
            x:Name="TimeBar"
            Columns="30"
            Rows="1"
            DotSize="2"
            Gap="2"
            OnColor="{StaticResource TertiaryColor}"
            OffColor="{StaticResource GlyphOffColor}" />
    </StackPanel>
</UserControl>
