<UserControl
    x:Class="Parpa.Views.PeekView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Parpa.Controls"
    Width="420"
    Height="112">

    <!-- Aviso (estilo isla): icono de app en baldosa de color + cabecera, cuerpo con dos botones píldora y
         una línea con el tiempo restante. -->
    <StackPanel Padding="16,10,16,12" Spacing="8">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="PeekTile"
                Width="24"
                Height="24"
                VerticalAlignment="Center"
                CornerRadius="7">
                <c:DotMatrix
                    x:Name="PeekGlyph"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DotSize="1.6"
                    Gap="0.8" />
            </Border>
            <TextBlock
                x:Name="Head"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontFamily="{StaticResource FontUi}"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryBrush}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="When"
                Grid.Column="2"
                VerticalAlignment="Center"
                FontFamily="{StaticResource FontUi}"
                FontSize="12"
                Foreground="{StaticResource MutedBrush}" />
        </Grid>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Cuerpo Geist 13 px / 1,35, máx. 2 líneas. -->
            <TextBlock
                x:Name="Body"
                VerticalAlignment="Center"
                FontFamily="{StaticResource FontUi}"
                FontSize="13"
                Foreground="{StaticResource PrimaryBrush}"
                LineHeight="17.55"
                LineStackingStrategy="BlockLineHeight"
                MaxLines="2"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <!-- Secundario: borde #2a2a2e. Principal: fondo claro. Píldoras mono 500 10 px, padding 6×10. -->
                <Border
                    x:Name="SecondaryButton"
                    Padding="14,7"
                    Background="{StaticResource BorderBrush}"
                    c:Pill.IsPill="True"
                    PointerEntered="SecondaryButton_PointerEntered"
                    PointerExited="SecondaryButton_PointerExited"
                    Tapped="SecondaryButton_Tapped">
                    <TextBlock
                        x:Name="SecondaryLabel"
                        FontFamily="{StaticResource FontUi}"
                        FontSize="12"
                        FontWeight="SemiBold" />
                </Border>
                <Border
                    x:Name="PrimaryButton"
                    Padding="14,7"
                    c:Pill.IsPill="True"
                    PointerEntered="PrimaryButton_PointerEntered"
                    PointerExited="PrimaryButton_PointerExited"
                    Tapped="PrimaryButton_Tapped">
                    <TextBlock
                        x:Name="PrimaryLabel"
                        FontFamily="{StaticResource FontUi}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BgBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Tiempo restante del aviso: línea redondeada que se acorta. -->
        <c:DotMatrix
            x:Name="TimeBar"
            Columns="30"
            Rows="1"
            DotSize="3"
            Gap="1"
            Merge="Blobs"
            OnBrush="{StaticResource BorderBrush}" />
    </StackPanel>
</UserControl>
