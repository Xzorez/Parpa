<UserControl
    x:Class="Parpa.Views.DropView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="420"
    Height="84">

    <!--
        Soltar: padding 10 14 14; una zona de puntos (7 px, radio 16) por acción, con glifo + etiqueta sobre negro.
        Con dos acciones, la que queda bajo el ratón se ilumina y es la que se hace al soltar.
    -->
    <Grid x:Name="Zones" Padding="14,10,14,14" ColumnSpacing="8" />
</UserControl>
