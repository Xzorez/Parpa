<UserControl
    x:Class="Parpa.Views.OsdView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Parpa.Controls"
    Width="340"
    Height="40">

    <!-- Indicador: padding 0 16 2, gap 12. Icono + etiqueta/subetiqueta + línea de nivel + valor (mín. 40). -->
    <Grid Padding="16,0,16,2" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <c:DotMatrix x:Name="IndicatorGlyph" VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock
                x:Name="Label"
                FontFamily="{StaticResource FontUi}"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryBrush}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="Sub"
                FontFamily="{StaticResource FontUi}"
                FontSize="11"
                Foreground="{StaticResource MutedBrush}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Grid
            x:Name="Bars"
            Grid.Column="2"
            Height="6"
            MinWidth="60"
            MaxWidth="150"
            VerticalAlignment="Center">
            <Border Background="{StaticResource BorderBrush}" CornerRadius="3" />
            <Border
                x:Name="BarFill"
                Width="0"
                HorizontalAlignment="Left"
                CornerRadius="3" />
        </Grid>

        <TextBlock
            x:Name="Value"
            Grid.Column="3"
            MinWidth="40"
            VerticalAlignment="Center"
            FontFamily="{StaticResource FontDisplay}"
            FontSize="15"
            FontWeight="SemiBold"
            Foreground="{StaticResource PrimaryBrush}"
            TextAlignment="Right" />
    </Grid>
</UserControl>
