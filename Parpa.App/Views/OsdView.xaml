<UserControl
    x:Class="Parpa.Views.OsdView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Parpa.Controls"
    Width="340"
    Height="40">

    <!-- Indicador: padding 0 16 2, gap 12. Glifo + etiqueta/subetiqueta + 16 barras + valor Doto 700 15 (mín. 40). -->
    <Grid Padding="16,0,16,2" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <c:DotMatrix x:Name="IndicatorGlyph" VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock
                x:Name="Label"
                CharacterSpacing="100"
                FontFamily="{StaticResource FontMono}"
                FontSize="10"
                FontWeight="Medium"
                Foreground="{StaticResource PrimaryBrush}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="Sub"
                CharacterSpacing="60"
                FontFamily="{StaticResource FontMono}"
                FontSize="9"
                Foreground="{StaticResource QuaternaryBrush}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel
            x:Name="Bars"
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="3" />

        <TextBlock
            x:Name="Value"
            Grid.Column="3"
            MinWidth="40"
            VerticalAlignment="Center"
            FontFamily="{StaticResource FontDisplay}"
            FontSize="15"
            FontWeight="Bold"
            Foreground="{StaticResource PrimaryBrush}"
            TextAlignment="Right" />
    </Grid>
</UserControl>
