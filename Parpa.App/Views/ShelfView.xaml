<UserControl
    x:Class="Parpa.Views.ShelfView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Parpa.Controls">

    <Grid>
        <!-- Archivos 1fr | panel 1.15fr, gap 8. -->
        <Grid x:Name="FilledPanel" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <!-- Tarjetas de 78 px en dos columnas, gap 6. -->
            <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
                <Grid x:Name="Tiles" ColumnSpacing="6" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </ScrollViewer>

            <!-- Nada elegido: zona de puntos con la pista. -->
            <Grid x:Name="PickHint" Grid.Column="1">
                <c:DotPattern DotColor="{StaticResource DotPatternColor}" Spacing="7" CornerRadius="14" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <TextBlock
                        x:Name="PickTitle"
                        HorizontalAlignment="Center"
                        CharacterSpacing="100"
                        FontFamily="{StaticResource FontMono}"
                        FontSize="10"
                        FontWeight="Medium"
                        Foreground="{StaticResource SoftBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="PickText"
                        HorizontalAlignment="Center"
                        CharacterSpacing="60"
                        FontFamily="{StaticResource FontMono}"
                        FontSize="9"
                        Foreground="{StaticResource QuaternaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Elegido: nombre, ruta y acciones en dos columnas (gap 4) + línea de resultado. -->
            <StackPanel
                x:Name="Detail"
                Grid.Column="1"
                Padding="12,10"
                Background="{StaticResource CardBrush}"
                CornerRadius="14"
                Spacing="6"
                Visibility="Collapsed">
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Name="DetailName"
                        FontFamily="{StaticResource FontUi}"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{StaticResource PrimaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="DetailPath"
                        FontFamily="{StaticResource FontMono}"
                        FontSize="9"
                        Foreground="{StaticResource QuaternaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid x:Name="Actions" ColumnSpacing="4" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
                <Grid Height="12" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="ResultDot" Width="6" Height="6" VerticalAlignment="Center" Visibility="Collapsed" />
                    <TextBlock
                        x:Name="Result"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        CharacterSpacing="100"
                        FontFamily="{StaticResource FontMono}"
                        FontSize="9"
                        FontWeight="Medium"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="Retry"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        CharacterSpacing="60"
                        FontFamily="{StaticResource FontMono}"
                        FontSize="9"
                        FontWeight="Medium"
                        Foreground="{StaticResource PrimaryBrush}"
                        Tapped="Retry_Tapped"
                        Visibility="Collapsed" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Bandeja vacía: puntos #3a3a3f de 7 px, mascota contenta y dos líneas sobre fondo negro. -->
        <Grid x:Name="EmptyPanel" Visibility="Collapsed">
            <c:DotPattern DotColor="{StaticResource DotPatternColor}" Spacing="7" CornerRadius="14" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <Border
                    Padding="8"
                    HorizontalAlignment="Center"
                    Background="{StaticResource BgBrush}"
                    CornerRadius="10">
                    <c:DotMatrix
                        x:Name="EmptyMascot"
                        Columns="13"
                        Rows="5"
                        DotSize="3"
                        Gap="1.5"
                        OnColor="{StaticResource PrimaryColor}"
                        OffColor="{StaticResource MatrixOffColor}" />
                </Border>
                <Border Padding="6,3" HorizontalAlignment="Center" Background="{StaticResource BgBrush}">
                    <TextBlock
                        x:Name="EmptyTitle"
                        CharacterSpacing="100"
                        FontFamily="{StaticResource FontMono}"
                        FontSize="10"
                        FontWeight="Medium"
                        Foreground="{StaticResource SoftBrush}" />
                </Border>
                <Border Padding="6,2" HorizontalAlignment="Center" Background="{StaticResource BgBrush}">
                    <TextBlock
                        x:Name="EmptyText"
                        CharacterSpacing="60"
                        FontFamily="{StaticResource FontMono}"
                        FontSize="9"
                        Foreground="{StaticResource SecondaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
