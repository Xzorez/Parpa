<UserControl
    x:Class="Parpa.Views.IdleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Parpa.Controls"
    Width="120"
    Height="34">

    <!-- Reposo: ojos de la mascota (píldoras redondeadas) o reloj; luna si No molestar. Gap 10. -->
    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="10">
        <c:DotMatrix
            x:Name="Mascot"
            Merge="Blobs"
            VerticalAlignment="Center"
            Columns="13"
            Rows="5"
            DotSize="3"
            Gap="1.5"
            OnBrush="{StaticResource PrimaryBrush}" />
        <TextBlock
            x:Name="Clock"
            VerticalAlignment="Center"
            FontFamily="{StaticResource FontDisplay}"
            FontSize="15"
            FontWeight="SemiBold"
            Foreground="{StaticResource PrimaryBrush}"
            Visibility="Collapsed" />
        <c:DotMatrix
            x:Name="Moon"
            VerticalAlignment="Center"
            Glyph="luna"
            OnBrush="{StaticResource SecondaryBrush}"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
