<UserControl
    x:Class="Parpa.Views.IdleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Parpa.Controls"
    Width="120"
    Height="34">

    <!-- Reposo: mascota 13×5 (puntos 3 px, gap 1,5) o reloj Doto 700 16 px; luna si No molestar. Gap 10. -->
    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="10">
        <c:DotMatrix
            x:Name="Mascot"
            VerticalAlignment="Center"
            Columns="13"
            Rows="5"
            DotSize="3"
            Gap="1.5"
            OnColor="{StaticResource PrimaryColor}"
            OffColor="{StaticResource MatrixOffColor}" />
        <TextBlock
            x:Name="Clock"
            VerticalAlignment="Center"
            FontFamily="{StaticResource FontDisplay}"
            FontSize="16"
            FontWeight="Bold"
            Foreground="{StaticResource PrimaryBrush}"
            Visibility="Collapsed" />
        <c:DotMatrix
            x:Name="Moon"
            VerticalAlignment="Center"
            Glyph="luna"
            OnColor="{StaticResource SecondaryColor}"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
