<UserControl
    x:Class="Parpa.Views.CompactView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Parpa.Controls"
    Height="34">

    <!-- Compacto: padding 0 14 2 12, gap 10. Glifo 7×7 + etiqueta (y subetiqueta) + elemento derecho. -->
    <Grid Padding="12,0,14,2" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <c:DotMatrix
            x:Name="ActivityGlyph"
            VerticalAlignment="Center"
            OnBrush="{StaticResource PrimaryBrush}"
            OffBrush="{StaticResource GlyphOffBrush}" />

        <TextBlock
            x:Name="Label"
            Grid.Column="1"
            VerticalAlignment="Center"
            CharacterSpacing="60"
            FontFamily="{StaticResource FontMono}"
            FontSize="11"
            FontWeight="Medium"
            Foreground="{StaticResource PrimaryBrush}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap">
            <Run x:Name="LabelMain" />
            <Run x:Name="LabelSub" Foreground="{StaticResource QuaternaryBrush}" />
        </TextBlock>

        <!-- Luna de No molestar junto a la actividad. -->
        <c:DotMatrix
            x:Name="Moon"
            Grid.Column="2"
            VerticalAlignment="Center"
            Glyph="luna"
            OnBrush="{StaticResource SecondaryBrush}"
            Visibility="Collapsed" />

        <!-- Temporizadores (foco…): Doto 700 16 px, tracking .02em. -->
        <TextBlock
            x:Name="RightText"
            Grid.Column="3"
            VerticalAlignment="Center"
            CharacterSpacing="20"
            FontFamily="{StaticResource FontDisplay}"
            FontSize="16"
            FontWeight="Bold"
            Foreground="{StaticResource PrimaryBrush}"
            Visibility="Collapsed" />

        <!-- Punto vivo (micro/cámara): 6 px en acento, parpadeo 1 ↔ 0,25 en pasos de 0,5 s. -->
        <Ellipse
            x:Name="LiveDot"
            Grid.Column="3"
            Width="6"
            Height="6"
            VerticalAlignment="Center"
            Visibility="Collapsed" />

        <!-- Ecualizador: 5 columnas × 4 filas, puntos 2 px, gap 1,5. Tick 100 ms; se congela en pausa. -->
        <c:DotMatrix
            x:Name="Equalizer"
            Grid.Column="3"
            VerticalAlignment="Center"
            Columns="5"
            Rows="4"
            DotSize="2"
            Gap="1.5"
            OnBrush="{StaticResource PrimaryBrush}"
            OffBrush="{StaticResource GlyphOffBrush}" />
    </Grid>
</UserControl>
