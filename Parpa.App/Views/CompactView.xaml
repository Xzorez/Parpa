<UserControl
    x:Class="Parpa.Views.CompactView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Parpa.Controls"
    Height="34">

    <!-- Compacto (estilo isla): icono + título (y artista) + elemento derecho, gap 10. -->
    <Grid Padding="14,0,16,2" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <c:DotMatrix
            x:Name="ActivityGlyph"
            VerticalAlignment="Center"
            OnBrush="{StaticResource PrimaryBrush}"
            OffBrush="{StaticResource GlyphOffBrush}" />

        <TextBlock
            x:Name="Label"
            Grid.Column="1"
            VerticalAlignment="Center"
            FontFamily="{StaticResource FontWide}"
            FontSize="12"
            FontStretch="Expanded"
            FontWeight="Black"
            Foreground="{StaticResource PrimaryBrush}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap">
            <Run x:Name="LabelMain" />
            <Run x:Name="LabelSub" FontSize="9" FontWeight="SemiBold" CharacterSpacing="120" Foreground="{StaticResource SecondaryBrush}" />
        </TextBlock>

        <!-- Luna de No molestar junto a la actividad. -->
        <c:DotMatrix
            x:Name="Moon"
            Grid.Column="2"
            VerticalAlignment="Center"
            Glyph="luna"
            OnBrush="{StaticResource SecondaryBrush}"
            Visibility="Collapsed" />

        <!-- Temporizadores (foco…): Segoe UI Variable Display semibold 15 px. -->
        <TextBlock
            x:Name="RightText"
            Grid.Column="3"
            VerticalAlignment="Center"
            FontSize="13"
            Style="{StaticResource Wide}"
            Visibility="Collapsed" />

        <!-- Punto vivo (micro/cámara): 6 px en acento, parpadeo 1 ↔ 0,25 en pasos de 0,5 s. -->
        <Ellipse
            x:Name="LiveDot"
            Grid.Column="3"
            Width="6"
            Height="6"
            VerticalAlignment="Center"
            Visibility="Collapsed" />

        <!-- Ecualizador: 5 barras redondeadas de 3 px que suben y bajan. Tick 100 ms; se congela en pausa. -->
        <c:DotMatrix
            x:Name="Equalizer"
            Grid.Column="3"
            VerticalAlignment="Center"
            Columns="5"
            Rows="4"
            DotSize="3"
            Gap="2"
            Merge="Columns" />
    </Grid>
</UserControl>
