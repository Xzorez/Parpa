<UserControl
    x:Class="Parpa.Views.CompactView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Parpa.Controls"
    Height="34">

    <!-- Compacto: padding 0 14 2 12, gap 10. Glifo 7×7 + etiqueta (y subetiqueta) + elemento derecho. -->
    <Grid Padding="12,0,14,2" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <c:DotMatrix
            x:Name="ActivityGlyph"
            VerticalAlignment="Center"
            OnColor="{StaticResource PrimaryColor}"
            OffColor="{StaticResource GlyphOffColor}" />

        <TextBlock
            x:Name="Label"
            Grid.Column="1"
            VerticalAlignment="Center"
            CharacterSpacing="60"
            FontFamily="{StaticResource FontMono}"
            FontSize="11"
            FontWeight="Medium"
            Foreground="{StaticResource PrimaryBrush}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap">
            <Run x:Name="LabelMain" />
            <Run x:Name="LabelSub" Foreground="{StaticResource QuaternaryBrush}" />
        </TextBlock>

        <!-- Ecualizador: 5 columnas × 4 filas, puntos 2 px, gap 1,5. Tick 100 ms; se congela en pausa. -->
        <c:DotMatrix
            x:Name="Equalizer"
            Grid.Column="2"
            VerticalAlignment="Center"
            Columns="5"
            Rows="4"
            DotSize="2"
            Gap="1.5"
            OnColor="{StaticResource PrimaryColor}"
            OffColor="{StaticResource GlyphOffColor}" />
    </Grid>
</UserControl>
