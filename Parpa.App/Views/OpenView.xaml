<UserControl
    x:Class="Parpa.Views.OpenView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Parpa.Controls"
    Width="580">

    <!-- Abierto: padding 12 18 18, gap 12. Cabecera 28 px en grid 1fr auto 1fr. -->
    <Grid Padding="18,12,18,18" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <c:DotMatrix
                    x:Name="PageGlyph"
                    VerticalAlignment="Center"
                    OnColor="{StaticResource PrimaryColor}"
                    OffColor="{StaticResource GlyphOffColor}" />
                <TextBlock
                    x:Name="PageTitle"
                    VerticalAlignment="Center"
                    CharacterSpacing="100"
                    FontFamily="{StaticResource FontMono}"
                    FontSize="10"
                    FontWeight="Medium"
                    Foreground="{StaticResource PrimaryBrush}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Botón de menú circular 28 px: abre/cierra el menú de burbujas. -->
            <Border
                x:Name="MenuButton"
                Grid.Column="1"
                Width="28"
                Height="28"
                Background="Transparent"
                CornerRadius="14"
                PointerEntered="MenuButton_PointerEntered"
                PointerExited="MenuButton_PointerExited"
                Tapped="MenuButton_Tapped">
                <c:DotMatrix
                    x:Name="MenuGlyph"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Glyph="menu"
                    OnColor="{StaticResource SecondaryColor}" />
            </Border>

            <TextBlock
                x:Name="Clock"
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontFamily="{StaticResource FontDisplay}"
                FontSize="20"
                FontWeight="Bold"
                Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock
                x:Name="HeaderRight"
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontFamily="{StaticResource FontMono}"
                FontSize="10"
                Visibility="Collapsed" />
        </Grid>

        <Grid x:Name="Body" Grid.Row="1" />
    </Grid>
</UserControl>
