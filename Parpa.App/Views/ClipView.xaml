<UserControl
    x:Class="Parpa.Views.ClipView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!-- Filas: padding 9 4, borde superior #1e1e21, Geist 12; índice Doto 700 14 #5a5a60. Clic = copiar. -->
        <ScrollViewer
            x:Name="ListScroll"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Hidden">
            <StackPanel x:Name="Rows" />
        </ScrollViewer>

        <!-- Vacío: dos filas fantasma + "COPIA ALGO CON [CTRL] [C] Y APARECERÁ AQUÍ". -->
        <StackPanel x:Name="Empty" Visibility="Collapsed">
            <Grid Padding="4,9" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource RowIndex}" Foreground="{StaticResource BorderBrush}" Text="01" />
                <Border Grid.Column="1" Height="6" Background="{StaticResource CardBrush}" CornerRadius="3" />
            </Grid>
            <Grid Padding="4,9" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource RowIndex}" Foreground="{StaticResource BorderBrush}" Text="02" />
                <Border Grid.Column="1" Height="6" Background="{StaticResource CardBrush}" CornerRadius="3" />
            </Grid>
            <StackPanel
                x:Name="EmptyHint"
                Padding="4,12,4,0"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Orientation="Horizontal"
                Spacing="10" />
        </StackPanel>
    </Grid>
</UserControl>
