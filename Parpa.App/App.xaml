<Application
    x:Class="Parpa.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Plantillas de TextBox y ScrollViewer (notas, nuevas tareas, listas). -->
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Tipografía (estilo Akira): todo en Archivo, como un cartel de una sola familia. -->
            <FontFamily x:Key="FontUi">ms-appx:///Assets/Fonts/Archivo-Variable.ttf#Archivo, Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="FontMono">ms-appx:///Assets/Fonts/Archivo-Variable.ttf#Archivo, Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="FontDisplay">ms-appx:///Assets/Fonts/Archivo-Variable.ttf#Archivo, Segoe UI Variable Display, Segoe UI</FontFamily>
            <!-- Estilo Akira: Archivo ancha y muy gruesa para títulos y cifras, y en pequeño muy espaciada. -->
            <FontFamily x:Key="FontWide">ms-appx:///Assets/Fonts/Archivo-Variable.ttf#Archivo, Arial Black</FontFamily>

            <!-- Campos de texto sin fondo ni borde en ningún estado (el diseño no los dibuja). -->
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />

            <!--
                Los colores (PrimaryColor, PrimaryBrush, …) se cargan desde Data/tokens.json en App.OnLaunched,
                y después se fusiona Styles.xaml, que los usa.
            -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
