<Application
    x:Class="Parpa.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Plantillas de TextBox y ScrollViewer (notas, nuevas tareas, listas). -->
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Geist, Geist Mono y Doto (SIL OFL), con las alternativas de tokens.json. -->
            <FontFamily x:Key="FontUi">ms-appx:///Assets/Fonts/Geist-Variable.ttf#Geist, Segoe UI Variable</FontFamily>
            <FontFamily x:Key="FontMono">ms-appx:///Assets/Fonts/GeistMono-Variable.ttf#Geist Mono, Cascadia Mono</FontFamily>
            <FontFamily x:Key="FontDisplay">ms-appx:///Assets/Fonts/Doto-Variable.ttf#Doto, Cascadia Mono</FontFamily>

            <!-- Campos de texto sin fondo ni borde en ningún estado (el diseño no los dibuja). -->
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />

            <!--
                Los colores (PrimaryColor, PrimaryBrush, …) se cargan desde Data/tokens.json en App.OnLaunched,
                y después se fusiona Styles.xaml, que los usa.
            -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
