<Application
    x:Class="Parpa.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Plantillas de TextBox y ScrollViewer (notas, nuevas tareas, listas). -->
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Tipografía del sistema (estilo isla): Segoe UI Variable para texto, etiquetas y números. -->
            <FontFamily x:Key="FontUi">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="FontMono">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>

            <!-- Campos de texto sin fondo ni borde en ningún estado (el diseño no los dibuja). -->
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />

            <!--
                Los colores (PrimaryColor, PrimaryBrush, …) se cargan desde Data/tokens.json en App.OnLaunched,
                y después se fusiona Styles.xaml, que los usa.
            -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
